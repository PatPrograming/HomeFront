# Single HomeFront env file (repo root). Copy to `.env` and fill in.
# Backend + Frontend both read this file. Never commit `.env`.

# --- AWS (region only; credentials come from your shell, never from this file) ---
AWS_REGION=us-east-1

# --- Cognito (public values, see Backend/infra/README.md) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_MLfQpodxG
COGNITO_STAFF_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
COGNITO_AGENT_CLIENT_ID=7aslk40jv9ikchoouqd00avdnp
COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com

# --- Gateway (Backend/infra/setup.sh --apply writes the AVP values to Backend/infra/.env.aws) ---
# Secret: signs mandate tokens. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_SIGNING_SECRET=
MANDATE_TABLE=mandate
AVP_POLICY_STORE_ID=
# JSON map of AVP policy id -> readable policy name, printed by setup.sh
AVP_POLICY_NAMES={}

# --- Bedrock Guardrails (used by the gateway's scan of inbox_read / web_scrape output) ---
GUARDRAIL_ID=l74ju5pcrcdg
GUARDRAIL_VERSION=2

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (Vite; every VITE_* value reaches the browser, so never put a secret here) ---
VITE_COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/
# Optional: API origin + /api/v1 when not using the dev proxy to 127.0.0.1:8080
# VITE_API_BASE=
# Mock mode (fake login + fake API), dev server only:
# VITE_MOCK_API=1

# --- api.data.gov (gateway-held; never sent to the browser or agents) ---
# Paste your key from https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Optional override: 1/0. If unset, live calls enable automatically when the key is set.
# HOMEFRONT_LIVE_DATAGOV=1
