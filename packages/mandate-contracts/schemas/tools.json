  {
    "name": "census_query",
    "description": "Query the U.S. Census Data API.",
    "inputSchema": {
      "properties": {
        "year": {
          "description": "Vintage year, e.g. '2023'.",
          "title": "Year",
          "type": "string"
        },
        "dataset": {
          "description": "Path after year, e.g. 'acs/acs1' or 'pep/population'.",
          "title": "Dataset",
          "type": "string"
        },
        "get": {
          "description": "Comma-separated variables, e.g. 'NAME,B01003_001E'.",
          "title": "Get",
          "type": "string"
        },
        "for": {
          "description": "Geography for= clause, e.g. 'place:69084'.",
          "title": "For",
          "type": "string"
        },
        "in": {
          "description": "Optional in= clause, e.g. 'state:06'. Use '' if none.",
          "title": "In",
          "type": "string"
        }
      },
      "required": [
        "year",
        "dataset",
        "get",
        "for",
        "in"
      ],
      "title": "CensusQueryInput",
      "type": "object"
    }
  },
