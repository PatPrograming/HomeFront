# Frontend settings. Copy these lines into the repo-root `.env` (vite.config.js reads the root folder).
# All VITE_* values end up in the browser, so they must never be secrets. These are public (lane A,
# docs/handover/cognito-public.md in the planning folder).

# Cognito managed login (user pool us-east-1_MLfQpodxG, public client staff-web, code + PKCE)
VITE_COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
# The console returns from Cognito to the address it's served from; that address must be in the Cognito client's callback list, which is http://localhost:3000/ only (see Backend/infra/cognito.sh).

# Optional: API origin + /api/v1 when not using the dev proxy to 127.0.0.1:8080
# VITE_API_BASE=

# Mock mode (fake login + fake API), dev server only. Leave unset for the real login.
# VITE_MOCK_API=1
