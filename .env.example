# Single HomeFront env file (repo root). Copy to `.env` and fill in.
# Backend + Frontend both read this file. Never commit `.env`.

# --- AWS (region only; credentials come from your shell, never from this file) ---
AWS_REGION=us-east-1

# --- Cognito (public values, see Backend/infra/README.md) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_MLfQpodxG
COGNITO_STAFF_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
COGNITO_AGENT_CLIENT_ID=7aslk40jv9ikchoouqd00avdnp
COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com

# --- Gateway (Backend/infra/setup.sh --apply writes the AVP values to Backend/infra/.env.aws) ---
# Secret: signs mandate tokens. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_SIGNING_SECRET=
MANDATE_TABLE=mandate
AVP_POLICY_STORE_ID=
# JSON map of AVP policy id -> readable policy name, printed by setup.sh
AVP_POLICY_NAMES={}

# --- Bedrock Guardrails (used by the gateway's scan of inbox_read / web_scrape output) ---
GUARDRAIL_ID=l74ju5pcrcdg
GUARDRAIL_VERSION=2

ALLOWED_ORIGINS=http://localhost:3000

# --- Chat agent auto-start (off unless set) ---
# 1 = the console starts `agent/agent.py --sid <sid> --chat` itself on the staffer's first message, one
# process per session (at most 3 running per staffer), stopped on revoke, offboarding, session end or server
# shutdown, at most 3 starts per session. Needs agent/.venv and agent/.env (the agent's own Cognito secret) on the server. The child
# gets only an allowlist (AWS credentials and region, PATH, HOME, CA bundle, gateway URLs), never
# MANDATE_SIGNING_SECRET. Starts and stops print in the gateway's terminal.
# HOMEFRONT_AUTOSTART_AGENT=1

# --- Conversation titles (sidebar) ---
# After the staffer's 1st and 3rd message the server names the conversation with Claude Haiku 5.5 on
# Bedrock, from the staffer's own messages only. On by default; 0 = always use the first words of the
# first message. Uses the server's AWS credentials (bedrock:InvokeModel on the profile below).
# HOMEFRONT_AUTO_TITLE=0
# HOMEFRONT_TITLE_MODEL_ID=us.anthropic.claude-haiku-5-5   # default; any Bedrock inference profile id

# --- Frontend (Vite; every VITE_* value reaches the browser, so never put a secret here) ---
VITE_COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
# The console returns from Cognito to the address it's served from; that address must be in the Cognito client's callback list, which is http://localhost:3000/ only (see Backend/infra/cognito.sh).
# Optional: API origin + /api/v1 when not using the dev proxy to 127.0.0.1:8080
# VITE_API_BASE=
# Mock mode (fake login + fake API), dev server only:
# VITE_MOCK_API=1

# --- Government API keys (gateway-held; never commit real values; never VITE_*) ---
# Signup links:
#   DATA_GOV_API_KEY  https://api.data.gov/signup/
#   CENSUS_API_KEY    https://api.census.gov/data/key_signup.html
#   OPENFDA_API_KEY   https://open.fda.gov/apis/authentication/
#   EIA_API_KEY       https://www.eia.gov/opendata/
#   NREL_API_KEY      https://developer.nrel.gov/signup/  (fallback for eia.query)
#   NASA_API_KEY      https://api.nasa.gov/
#   NOAA_CDO_TOKEN    https://www.ncdc.noaa.gov/cdo-web/token
#   NPS_API_KEY       https://www.nps.gov/subjects/developer/get-started.htm
#   BLS_API_KEY       https://www.bls.gov/developers/home.htm
#   EPA / FEC / FCC   often use api.data.gov — see https://api.data.gov/
#
# Tools: datagov.search, census.query, openfda.search, eia.query, nasa.search,
# noaa.climate, nps.parks, bls.series, fec.search, epa.search, fcc.search.
DATA_GOV_API_KEY=
CENSUS_API_KEY=
OPENFDA_API_KEY=
EIA_API_KEY=
NREL_API_KEY=
NASA_API_KEY=
NOAA_CDO_TOKEN=
NPS_API_KEY=
BLS_API_KEY=
EPA_API_KEY=
FEC_API_KEY=
FCC_API_KEY=
# Optional override: 1/0. If unset, live Catalog calls enable automatically when DATA_GOV_API_KEY is set.
# HOMEFRONT_LIVE_DATAGOV=1
# sam.entity_lookup (market research) uses the same key against api.sam.gov; live only
# when the key is set AND this is 1. Otherwise results are simulated.
# HOMEFRONT_LIVE_SAM=1

# --- Other external tools (simulated unless enabled) ---
# web.scrape: 1 = fetch real pages. Only public http(s) hosts are reachable (no
# metadata endpoint, localhost or private networks), redirects included.
HOMEFRONT_LIVE_SCRAPE=1
# usaspending.search: 1 = query the public USAspending.gov API (no key needed).
# HOMEFRONT_LIVE_USASPENDING=1

# --- Outbound email via Amazon SES ---
# Our mandate flow: email_send runs only after the Cedar ALLOW in guarded().
# Teammates' agents: each agent's sender, name, reply-to and signature are set in its
# "Email setup" on the Agents tab; HOMEFRONT_EMAIL_FROM is only the fallback.
# Unset (and no per-agent sender) = simulated (nothing is delivered); keep it unset for tests and the demo.
# Senders must be SES-verified (address or domain); in the SES sandbox, recipients must be verified too.
# Uses the server's AWS credentials (ses:SendEmail, ses:GetEmailIdentity); nothing here is returned to the agent.
# HOMEFRONT_EMAIL_FROM=agency@example.gov
# HOMEFRONT_SES_REGION=us-east-1   # defaults to AWS_REGION

# --- Teammates' agent tabs (Agents, Monitoring, Approvals, Activity) ---
# Always behind our Cognito login: staff read, the admin group changes things.
# memory (default, lost on restart) | dynamodb (<DYNAMODB_TABLE_PREFIX>agents/audit/approvals)
# AGENT_STORE=memory
# "Run a task": Claude on Amazon Bedrock. A region turns the runner on (falls back to AWS_REGION).
# BEDROCK_REGION=
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
# RUNNER_EFFORT=medium
