# Single HomeFront env file (repo root). Copy to `.env` and fill in.
# Backend + Frontend both read this file. Never commit `.env`.

# --- AWS ---
# Region for DynamoDB (and Bedrock, unless BEDROCK_REGION is set). Credentials
# come from the standard AWS chain: AWS_PROFILE, access keys, SSO, or a role.
AWS_REGION=us-east-1

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- User auth: Amazon Cognito (CloudFormation outputs UserPoolId / UserPoolClientId) ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Frontend (Vite) maps these via vite.config.js — optional overrides:
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_CLIENT_ID=
# VITE_API_BASE=

# true = /agents*, /auth/token and /audit require a signed-in Cognito user.
AGENT_ADMIN_REQUIRES_LOGIN=false

# --- Data: Amazon DynamoDB ---
# Table names are <prefix>profiles, <prefix>usernames, <prefix>agents.
DYNAMODB_TABLE_PREFIX=homefront-
# For DynamoDB Local (scripts/run-dynamodb-local.sh). Leave empty for real AWS.
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
# memory (default, lost on restart) | dynamodb (<prefix>agents table)
AGENT_STORE=memory

# --- api.data.gov (gateway-held; never sent to the browser or agents) ---
# Paste your key from https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Optional override: 1/0. If unset, live calls enable automatically when the key is set.
# HOMEFRONT_LIVE_DATAGOV=1

# --- Outbound email (email.send / email.send_list, after human approval) via Amazon SES ---
# Each agent's sender, name, reply-to and signature are set in its "Email setup" on
# the My agents page. HOMEFRONT_EMAIL_FROM is only the fallback for agents with no
# sender of their own; with neither, sends are simulated (nothing is delivered).
# Senders must be SES-verified (address or domain); in the SES sandbox, recipients
# must be verified too. Needs AWS credentials with ses:SendEmail (and
# ses:GetEmailIdentity for the "Verified in SES" check).
# HOMEFRONT_EMAIL_FROM=agency@example.gov
# HOMEFRONT_SES_REGION=us-east-1   # defaults to AWS_REGION

# --- Agent runner: Claude on Amazon Bedrock ---
# Region turns the runner on (or set AWS_REGION). Needs Bedrock model access
# for the models below in this region.
BEDROCK_REGION=
# Auth, pick one: a Bedrock API key here, or standard AWS credentials
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, SSO, instance role).
AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Used automatically if the primary model declines a request. Empty = off.
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
# low | medium | high | xhigh | max
RUNNER_EFFORT=medium
