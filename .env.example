# Single HomeFront env file (repo root). Copy to `.env` and fill in.
# Backend + Frontend both read this file. Never commit `.env`.

# --- AWS (region only; credentials come from your shell, never from this file) ---
AWS_REGION=us-east-1

# --- Cognito (public values, see Backend/infra/README.md) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_MLfQpodxG
COGNITO_STAFF_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
COGNITO_AGENT_CLIENT_ID=7aslk40jv9ikchoouqd00avdnp
COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com

# --- Gateway (Backend/infra/setup.sh --apply writes the AVP values to Backend/infra/.env.aws) ---
# Secret: signs mandate tokens. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_SIGNING_SECRET=
MANDATE_TABLE=mandate
AVP_POLICY_STORE_ID=
# JSON map of AVP policy id -> readable policy name, printed by setup.sh
AVP_POLICY_NAMES={}

# --- Bedrock Guardrails (used by the gateway's scan of inbox_read / web_scrape output) ---
GUARDRAIL_ID=l74ju5pcrcdg
GUARDRAIL_VERSION=2

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Chat agent auto-start (off unless set) ---
# 1 = the console starts `agent/agent.py --sid <sid> --chat` itself on the staffer's first message, one
# process per session, stopped on revoke, offboarding, session end or server shutdown, at most 3 starts
# per session. Needs agent/.venv and agent/.env (the agent's own Cognito secret) on the server. The child
# gets only AWS credentials, region and PATH from this process, never MANDATE_SIGNING_SECRET.
# HOMEFRONT_AUTOSTART_AGENT=1

# --- Frontend (Vite; every VITE_* value reaches the browser, so never put a secret here) ---
VITE_COGNITO_DOMAIN=https://mandate-a10-hack-2026.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=5be15oitnpm14bg188jpqqs9qv
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
# Optional: API origin + /api/v1 when not using the dev proxy to 127.0.0.1:8080
# VITE_API_BASE=
# Mock mode (fake login + fake API), dev server only:
# VITE_MOCK_API=1

# --- api.data.gov (gateway-held; never sent to the browser or agents) ---
# Paste your key from https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Optional override: 1/0. If unset, live calls enable automatically when the key is set.
# HOMEFRONT_LIVE_DATAGOV=1

# --- Outbound email via Amazon SES ---
# Our mandate flow: email_send runs only after the Cedar ALLOW in guarded().
# Teammates' agents: each agent's sender, name, reply-to and signature are set in its
# "Email setup" on the Agents tab; HOMEFRONT_EMAIL_FROM is only the fallback.
# Unset (and no per-agent sender) = simulated (nothing is delivered); keep it unset for tests and the demo.
# Senders must be SES-verified (address or domain); in the SES sandbox, recipients must be verified too.
# Uses the server's AWS credentials (ses:SendEmail, ses:GetEmailIdentity); nothing here is returned to the agent.
# HOMEFRONT_EMAIL_FROM=agency@example.gov
# HOMEFRONT_SES_REGION=us-east-1   # defaults to AWS_REGION

# --- Teammates' agent tabs (Agents, Monitoring, Approvals, Activity) ---
# Always behind our Cognito login: staff read, the admin group changes things.
# memory (default, lost on restart) | dynamodb (<DYNAMODB_TABLE_PREFIX>agents/audit/approvals)
# AGENT_STORE=memory
# "Run a task": Claude on Amazon Bedrock. A region turns the runner on (falls back to AWS_REGION).
# BEDROCK_REGION=
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
# RUNNER_EFFORT=medium
