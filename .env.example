# Single HomeFront env file (repo root). Copy to `.env` and fill in.
# Backend + Frontend both read this file. Never commit `.env`.

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy projects that sign JWTs with HS256. Leave empty to use JWKS.
SUPABASE_JWT_SECRET=

# Frontend (Vite) reads the same URL/anon key via vite.config.js mapping.
# Optional override if you must set Vite-specific values:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# true = /agents*, /auth/token and /audit require a logged-in Supabase user.
AGENT_ADMIN_REQUIRES_LOGIN=false

# --- api.data.gov (gateway-held; never sent to the browser or agents) ---
# Paste your key from https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Optional override: 1/0. If unset, live calls enable automatically when the key is set.
# HOMEFRONT_LIVE_DATAGOV=1
